# NalaBase Backend Environment Variables
# Copy to .env and fill in values

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host/nalabase?sslmode=require

# JWT
SECRET_KEY=your-256-bit-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=NalaBase
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://nalabase.vercel.app

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
